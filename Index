            saveProgress();
            updateProgressUI();

            alert('✅ Data LKPD berhasil disimpan di memori lokal!');
        }

        function clearLKPD() {
            if(confirm('Apakah Anda yakin ingin mengosongkan seluruh isian LKPD?')) {
                document.getElementById('lkpdNama').value = '';
                document.getElementById('lkpdKelas').value = '';
                document.getElementById('lkpdQ1').value = '';
                document.getElementById('lkpdQ2').value = '';
                document.getElementById('lkpdQ3').value = '';
                document.getElementById('lkpdQ4').value = '';
                localStorage.removeItem('mpi_bk_lkpd');
            }
        }

        /* ================= MENU 6: EVALUASI LOGIC ================= */
        function renderEvalQuestion() {
            const q = evalQuestions[state.evalCurrentQuestion];
            document.getElementById('evalProgressText').innerText = `Soal ${state.evalCurrentQuestion + 1} / ${evalQuestions.length}`;
            document.getElementById('evalQuestionText').innerText = q.q;

            const badge = document.getElementById('evalTypeBadge');
            if(q.type === 'pg') badge.innerText = "Pilihan Ganda (5 Poin)";
            else if(q.type === 'bs') badge.innerText = "Benar / Salah (4 Poin)";
            else badge.innerText = "Studi Kasus (15 Poin)";

            const container = document.getElementById('evalOptionsContainer');
            container.innerHTML = '';

            q.options.forEach((opt, idx) => {
                const isSelected = state.evalAnswers[state.evalCurrentQuestion] === idx;
                const btn = document.createElement('button');
                btn.className = `w-full text-left p-4 rounded-2xl border-2 text-xs sm:text-sm font-semibold transition ${isSelected ? 'border-emerald-600 bg-emerald-50 text-emerald-900 font-bold' : 'border-slate-200 bg-white hover:border-emerald-400 text-slate-700'}`;
                btn.innerText = opt;
                btn.onclick = () => {
                    state.evalAnswers[state.evalCurrentQuestion] = idx;
                    renderEvalQuestion();
                };
                container.appendChild(btn);
            });

            document.getElementById('evalPrevBtn').disabled = (state.evalCurrentQuestion === 0);
            document.getElementById('evalNextBtn').innerText = (state.evalCurrentQuestion === evalQuestions.length - 1) ? "Selesai & Hitung Nilai" : "Soal Selanjutnya →";
        }

        function navigateEval(dir) {
            const nextIdx = state.evalCurrentQuestion + dir;
            if(nextIdx >= 0 && nextIdx < evalQuestions.length) {
                state.evalCurrentQuestion = nextIdx;
                renderEvalQuestion();
            } else if(nextIdx >= evalQuestions.length) {
                calculateEvalResult();
            }
        }

        function calculateEvalResult() {
            let totalScore = 0;
            evalQuestions.forEach((q, idx) => {
                const userAns = state.evalAnswers[idx];
                if(userAns === q.ans) {
                    if(q.type === 'pg') totalScore += 5;
                    else if(q.type === 'bs') totalScore += 4;
                    else if(q.type === 'sk') totalScore += 15;
                }
            });

            document.getElementById('evalQuizBox').classList.add('hidden');
            const resBox = document.getElementById('evalResultBox');
            resBox.classList.remove('hidden');

            document.getElementById('evalScoreDisplay').innerText = totalScore;

            let predicate = "";
            let motivation = "";
            if(totalScore >= 90) {
                predicate = "Predikat: Sangat Baik (90-100)";
                motivation = "Luar biasa! Pemahamanmu sangat mendalam. Kamu siap menjadi Pelopor Duta Anti-Bullying SMK PERINTIS!";
            } else if(totalScore >= 80) {
                predicate = "Predikat: Baik (80-89)";
                motivation = "Sangat bagus! Kamu memiliki kepedulian dan pemahaman yang kuat untuk mencegah perundungan.";
            } else if(totalScore >= 70) {
                predicate = "Predikat: Cukup (70-79)";
                motivation = "Cukup baik. Pelajari lagi beberapa poin materi agar lebih siap menghadapi situasi perundungan.";
            } else {
                predicate = "Predikat: Perlu Belajar Kembali (< 70)";
                motivation = "Jangan patah semangat! Mari ulas kembali slide materi dan jalankan ulang simulasi.";
            }

            document.getElementById('evalPredicateDisplay').innerText = predicate;
            document.getElementById('evalMotivationMsg').innerText = motivation;

            // Populate discussion list
            const discContainer = document.getElementById('discussionList');
            discContainer.innerHTML = '';
            evalQuestions.forEach((q, idx) => {
                const p = document.createElement('p');
                p.innerHTML = `<strong>Soal ${idx+1}:</strong> ${q.explanation}`;
                discContainer.appendChild(p);
            });

            state.completedMenus.add('menu6');
            saveProgress();
            updateProgressUI();

            if(state.audioEnabled) {
                speakText(`Hasil evaluasi pembelajaranmu adalah ${totalScore}. ${predicate}. ${motivation}`);
            }
        }

        function toggleDiscussion() {
            const content = document.getElementById('evalDiscussionContent');
            content.classList.toggle('hidden');
        }

        function restartEvaluation() {
            state.evalAnswers = {};
            state.evalCurrentQuestion = 0;
            document.getElementById('evalResultBox').classList.add('hidden');
            document.getElementById('evalQuizBox').classList.remove('hidden');
            renderEvalQuestion();
        }

        /* ================= PERSISTENCE & UTILS ================= */
        function saveProgress() {
            const data = {
                gameScore: state.gameScore,
                completedMenus: Array.from(state.completedMenus)
            };
            localStorage.setItem('mpi_bk_progress', JSON.stringify(data));
        }

        function loadProgress() {
            const saved = localStorage.getItem('mpi_bk_progress');
            if(saved) {
                try {
                    const parsed = JSON.parse(saved);
                    state.gameScore = parsed.gameScore || 0;
                    state.completedMenus = new Set(parsed.completedMenus || []);
                    document.getElementById('gameTotalScore').innerText = `${state.gameScore} Poin`;
                } catch(e){}
            }

            // Load Saved LKPD
            const savedLKPD = localStorage.getItem('mpi_bk_lkpd');
            if(savedLKPD) {
                try {
                    const lkpd = JSON.parse(savedLKPD);
                    if(lkpd.nama) document.getElementById('lkpdNama').value = lkpd.nama;
                    if(lkpd.kelas) document.getElementById('lkpdKelas').value = lkpd.kelas;
                    if(lkpd.q1) document.getElementById('lkpdQ1').value = lkpd.q1;
                    if(lkpd.q2) document.getElementById('lkpdQ2').value = lkpd.q2;
                    if(lkpd.q3) document.getElementById('lkpdQ3').value = lkpd.q3;
                    if(lkpd.q4) document.getElementById('lkpdQ4').value = lkpd.q4;
                } catch(e){}
            }

            updateProgressUI();
        }

        function updateProgressUI() {
            const total = 7;
            const completed = state.completedMenus.size;
            const pct = Math.round((completed / total) * 100);

            document.getElementById('overallProgressBar').style.width = `${pct}%`;
            document.getElementById('overallProgressText').innerText = `${pct}%`;

            // Menu Dashboard Badges
            state.completedMenus.forEach(menuId => {
                const badge = document.getElementById(`badge-${menuId}`);
                if(badge) {
                    badge.className = "px-2.5 py-1 bg-emerald-100 text-emerald-700 rounded-full font-bold";
                    badge.innerText = "Selesai ✓";
                }
            });
        }

        function resetProgress() {
            if(confirm('Apakah Anda yakin ingin menghapus seluruh progres pembelajaran?')) {
                localStorage.clear();
                state.completedMenus.clear();
                state.gameScore = 0;
                location.reload();
            }
        }

        function openModal(id) {
            document.getElementById(id).classList.remove('hidden');
        }

        function closeModal(id) {
            document.getElementById(id).classList.add('hidden');
        }

        // Web Audio Synthesizer Sound Generator
        function playSynthSound(freq, duration) {
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();

                osc.type = 'sine';
                osc.frequency.setValueAtTime(freq, ctx.currentTime);
                gain.gain.setValueAtTime(0.1, ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + duration);

                osc.connect(gain);
                gain.connect(ctx.destination);

                osc.start();
                osc.stop(ctx.currentTime + duration);
            } catch(e) {}
        }
    </script>
