        function showScreen(screenId) {
            // Hide all screen sections
            document.querySelectorAll('.screen-section').forEach(el => el.classList.add('hidden'));
            
            // Show target section
            const target = document.getElementById(screenId);
            if(target) {
                target.classList.remove('hidden');
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            // Mark completed menu progress
            if(screenId.startsWith('menu')) {
                state.completedMenus.add(screenId);
                saveProgress();
                updateProgressUI();
            }

            // Speech Narration Trigger per Screen
            if(state.audioEnabled) {
                synth.cancel(); // Stop ongoing speech
                if(screenId === 'landingScreen') {
                    speakText("Selamat datang di Media Pembelajaran Interaktif BK. Bullying: Berani Peduli, Berani Bertindak!");
                } else if(screenId === 'dashboardScreen') {
                    speakText("Silakan pilih salah satu dari tujuh menu pembelajaran anti bullying.");
                } else if(screenId === 'menu1') {
                    speakMateriCurrent();
                } else if(screenId === 'menu7') {
                    speakText("Profil Pengembang: Ibu Nurul Hidayah, S.Pd. Guru Bimbingan dan Konseling SMK PERINTIS.");
                }
            }
        }

        /* ================= WEB SPEECH API (AUDIO NARRATION) ================= */
        function speakText(text) {
            if(!state.audioEnabled || !('speechSynthesis' in window)) return;
            
            synth.cancel();
            speechUtterance = new SpeechSynthesisUtterance(text);
            speechUtterance.lang = 'id-ID';
            speechUtterance.rate = 0.9; // Mild readable tempo
            speechUtterance.pitch = 1.0;
            synth.speak(speechUtterance);
        }

        function toggleAudio() {
            state.audioEnabled = !state.audioEnabled;
            const icon = document.getElementById('ttsIcon');
            const text = document.getElementById('ttsText');

            if(state.audioEnabled) {
                icon.className = "fa-solid fa-volume-high text-yellow-300";
                text.innerText = "Suara: ON";
                speakText("Fitur suara aktif.");
            } else {
                synth.cancel();
                icon.className = "fa-solid fa-volume-xmark text-slate-400";
                text.innerText = "Suara: OFF";
            }
        }

